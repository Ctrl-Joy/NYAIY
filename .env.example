# Server-side keys (never commit .env)
GROQ_API_KEY=your_groq_api_key_here

# Optional — improves NyaiyBERT classification rate limits
HF_API_TOKEN=

PORT=3001
NODE_ENV=development

# Windows/Node 24: fixes SSL errors when calling Groq
NODE_OPTIONS=--use-system-ca
# Set false on Windows if you still see "fetch failed" (dev only)
GROQ_SSL_VERIFY=false

# Set true after npm run build to serve React from the same port
# SERVE_STATIC=true

# Optional — CRA dev client origin
CLIENT_ORIGIN=http://localhost:3000

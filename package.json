{
  "name": "nyaiy",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^13.5.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.16.0",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-scripts": "5.0.1",
    "tesseract.js": "^7.0.0",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "postinstall": "node -e \"const fs=require('fs');const p='node_modules/pdfjs-dist/build/pdf.worker.min.mjs';const d='public/pdf.worker.min.mjs';if(fs.existsSync(p))fs.copyFileSync(p,d);\"",
    "server": "node --use-system-ca server/index.js",
    "client": "react-scripts start",
    "dev": "concurrently -n server,client -c blue,green \"npm run server\" \"npm run client\"",
    "start": "concurrently -n server,client -c blue,green \"npm run server\" \"npm run client\"",
    "build": "react-scripts build",
    "start:prod": "node --use-system-ca server/index.js",
    "test": "react-scripts test --watchAll=false",
    "eject": "react-scripts eject"
  },
  "proxy": "http://localhost:3001",
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19"
  }
}

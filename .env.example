# Server-side keys (never commit .env, never use REACT_APP_* for keys)
GROQ_API_KEY=your_groq_api_key_here

# Optional: enables the NyaiyBERT classifier on Hugging Face
HF_API_TOKEN=

# Port for the local API server (the React dev server uses PORT, default 3000)
API_PORT=3001

# Optional: allow one other origin to call the API
# CLIENT_ORIGIN=http://localhost:3000

# Only if you hit certificate errors calling Groq locally
# GROQ_SSL_VERIFY=false
